<Project Sdk="Microsoft.NET.Sdk">

  <!-- Standalone regression harness for the command-injection fixes (issue #1).
       References the real SourceGit project and exercises the actual command
       builders and Command.CreateGitStartInfo, so it cannot drift from production. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPublishable>false</IsPublishable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SourceGit.csproj" />
  </ItemGroup>

</Project>
